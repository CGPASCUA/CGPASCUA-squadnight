# Copy this file to .env and adjust for local development.
# These are read at BUILD time (Vite bakes them into the bundle), so changing
# them means rebuilding, not just refreshing the page.

# Set to "false" to use the real Express API instead of the browser-only mock.
# Leaving this unset (or anything other than "false") keeps demo mode on.
VITE_USE_MOCK_API=true

# Only used when VITE_USE_MOCK_API=false. Your deployed Render API's base URL,
# no trailing slash — e.g. https://squadnight-api.onrender.com
VITE_API_BASE_URL=
